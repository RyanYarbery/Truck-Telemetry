[Unit]
Description=Truck Telemetry 1024x600 Dashboard
After=systemd-user-sessions.service

[Service]
Type=simple
User=ryan
Group=ryan
WorkingDirectory=/opt/truck-dashboard

StateDirectory=truck-dashboard
StateDirectoryMode=0755

Environment=SDL_VIDEODRIVER=kmsdrm
Environment=SDL_AUDIODRIVER=dummy
Environment=PYTHONUNBUFFERED=1

ExecStart=/usr/bin/python3 /opt/truck-dashboard/dashboard.py

Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
